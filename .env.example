# Supabase (Project settings → API). The service-role key stays server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Protects the cron endpoints. Vercel sends it as `Authorization: Bearer <CRON_SECRET>` automatically.
CRON_SECRET=change-me

# Alert channels — leave any blank to disable that channel.
TELEGRAM_BOT_TOKEN=            # @BotFather
TELEGRAM_WEBHOOK_SECRET=       # any random string; verifies webhook calls
TELEGRAM_CHAT_ID=              # optional admin chat that gets every signal unfiltered
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=signals@yourdomain.com

# Engine thresholds (defaults shown). All USD unless noted.
MIN_FILL_USD=50
NEW_POSITION_MIN_USD=2000
CONVICTION_ADD_RATIO=0.5
EARLY_ENTRY_MAX_PRICE=0.35
EARLY_ENTRY_MAX_DAYS=30
EXIT_SELL_RATIO=0.6
CONSENSUS_WINDOW_HOURS=72
DEDUPE_MINUTES=10
MIN_COPY_SCORE=40
